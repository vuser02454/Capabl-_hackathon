# Copy to backend/.env — loaded automatically on startup.

# Free API key from https://explore.openaq.org (sign in, then create an API key).
OPENAQ_API_KEY=

# auto   = use OpenAQ when OPENAQ_API_KEY is set, otherwise the demo dataset
# openaq = always OpenAQ (analysis reports a clear error if the key is missing)
# mock   = always the demo dataset
ECOSENTINEL_AIR_PROVIDER=auto

# Station search radius (max 25000 m) and how old a reading may be before it is ignored.
ECOSENTINEL_OPENAQ_RADIUS_M=25000
ECOSENTINEL_OPENAQ_MAX_AGE_HOURS=24
# Pollutants the nearest fresh station does not measure are filled from other nearby stations,
# using "latest available" readings up to this age (flagged as delayed in the report).
ECOSENTINEL_OPENAQ_FILL_MAX_AGE_HOURS=96
ECOSENTINEL_OPENAQ_TIMEOUT=6

# --- Geocoding (OpenStreetMap Nominatim) ---
# Serves BOTH directions, through the backend only — the browser never calls Nominatim itself:
#   POST /api/location/reverse   coordinates -> place name (browser geolocation)
#   POST /api/location/search    place name  -> coordinates (manual search)
# Identify the app per the Nominatim usage policy; optionally add a contact email. The client
# serialises requests to at most one per second and caches results, which is only possible
# because every call goes through this backend.
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ECOSENTINEL_NOMINATIM_USER_AGENT=EcoSentinel-AI/1.0 (environmental monitoring hackathon project)
NOMINATIM_EMAIL=
# Re-use a resolved place name until the user moves further than this.
ECOSENTINEL_GEOCODE_CACHE_DISTANCE_M=100

# --- Water sources ---
# auto = nearest IoT sensor -> monitoring station -> dataset (never demo); mock = demo data
ECOSENTINEL_WATER_PROVIDER=auto
# ECOSENTINEL_WATER_REGISTRY_PATH=../shared/water_sensors.json
ECOSENTINEL_WATER_SENSOR_RADIUS_KM=10
ECOSENTINEL_WATER_MAX_AGE_MINUTES=60
# Optional historical fallback, e.g. backend/data/water_dataset.json (format: water_dataset.example.json)
ECOSENTINEL_WATER_DATASET_PATH=
ECOSENTINEL_WATER_DATASET_RADIUS_KM=25
# ESP32 -> Firebase RTDB (reads /sensors/{sensorId}/latest.json)
FIREBASE_DB_URL=
FIREBASE_AUTH_TOKEN=
# Enables POST /api/sensors/water/{sensorId}/readings for ESP32 boards / an MQTT bridge
ECOSENTINEL_SENSOR_INGEST_TOKEN=

# --- LangGraph orchestration (agents/langgraph_orchestrator.py) ---
# POST /api/analyze runs through the LangGraph StateGraph orchestrator by default: location
# resolution, then the air/water/waste specialists in parallel, then the Coordinator. Set to
# false to fall back to the original sequential AnalysisOrchestrator (agents/orchestrator.py).
ECOSENTINEL_LANGGRAPH_ORCHESTRATION=true

# Maximum accepted image upload, in megabytes. The frontend mirrors this in
# frontend/src/services/providers/wasteDetectionSource.ts (MAX_UPLOAD_BYTES) so an oversized file
# is rejected before it is uploaded — raise both together, or the browser will send a file the
# backend then refuses.
ECOSENTINEL_MAX_UPLOAD_MB=25

# --- AI provider roles ------------------------------------------------------------------
# TWO roles, deliberately NOT interchangeable. Do not set an explainability provider as the
# functional one: they carry different guarantees, and the backend refuses the swap.
#
#   FUNCTIONAL (Gemini)              performs AI work INSIDE the pipeline. Its output is
#                                    validated against a Pydantic schema and enters as EVIDENCE,
#                                    which the deterministic engine weighs like any other signal.
#                                    It can never set a risk score or a severity.
#
#   EXPLAINABILITY (OpenRouter/Groq) receives an ALREADY-FINAL decision and puts it into words.
#                                    It cannot reach the risk score, confidence, priorities,
#                                    evidence or primary problem. If it disagrees with the
#                                    decision, the decision wins and the disagreement is visible.
#
# Both default to "none", and the full pipeline runs with neither configured — every explanation
# then falls back to deterministic text. No key is ever sent to the browser.

# none | gemini
FUNCTIONAL_AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# none | openrouter | groq   (no automatic failover between them: the configured one is used)
EXPLAINABILITY_AI_PROVIDER=none
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Shared ceiling for both roles.
LLM_TIMEOUT_SECONDS=30

# --- Coordinator LLM narrative (legacy, optional) ---
# The Coordinator's risk score and structured findings are ALWAYS deterministic (core/risk.py) —
# an LLM never sets a number. When set, an LLM only adds an extra narrative on top of that
# result (agents/llm_reasoning.py). Leave as "none" (the default) to run fully offline.
# provider: none | gemini | openai | groq  (install the matching optional LangChain package)
LLM_PROVIDER=none
LLM_MODEL=
# Falls back to the provider's own env var (GOOGLE_API_KEY / OPENAI_API_KEY / GROQ_API_KEY) when unset.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8

# --- Water Pollution Vision (YOLO26 Nano) -----------------------------------------------
# Visual detection of pollution objects in water imagery, consumed by the Water Quality Agent.
# This is a VISUAL signal only — it cannot measure pH, turbidity, dissolved oxygen or
# chemistry. Those always come from the sensor/dataset readings.
#
# Leave everything unset and the Water Agent works exactly as before: visualPollution reports
# status "model_not_configured" and the water-quality score is used unchanged.
#
# provider: auto (default) | local | roboflow | off
ECOSENTINEL_WATER_VISION_PROVIDER=auto

# Option A — local Ultralytics-compatible weights (absolute path, or relative to backend/).
# Requires: pip install ultralytics   (pulls torch, ~2 GB on disk)
#
# Verified working configuration:
#   ECOSENTINEL_WATER_VISION_PROVIDER=local
#   YOLO26_MODEL_PATH=models/yolov8n.pt
#
# Fetch the weights once:
#   cd backend/models && python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"
#
# yolov8n is COCO-pretrained (80 classes incl. bottle/cup/bowl/boat) — a REAL detector, but not
# waste-specific: on turbid close-ups of water it will usually detect nothing, which the UI
# reports honestly rather than padding. The Water Agent keeps this model. Waste detection uses
# WASTE_DETECTOR_MODEL_PATH so the two agents do not share weights.
YOLO26_MODEL_PATH=

# Option A2 — TACO-trained waste detector for POST /api/waste/segregate.
# Train with training/train_waste_detector.py; default export is backend/models/waste_detector.pt.
# WASTE_DETECTOR_MODEL_PATH=models/waste_detector.pt

# Option B — Roboflow hosted inference. Never commit real credentials.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
# ROBOFLOW_BASE_URL=https://detect.roboflow.com
# ROBOFLOW_TIMEOUT_SECONDS=12

# Minimum detection confidence (0..1).
YOLO_CONFIDENCE_THRESHOLD=0.25

# Maximum escalation the visual signal may add to the measured water-quality score.
# The visual signal can only RAISE risk, never lower it (see agents/water_agent.py).
ECOSENTINEL_WATER_VISUAL_WEIGHT=0.25
# Object count in one frame treated as maximum visual pollution density.
ECOSENTINEL_WATER_VISUAL_COUNT_REFERENCE=20

# --- Reference-dataset appearance matching (Water Agent) ---
# Compares an uploaded/live water photo against labelled reference frames laid out as
# <images path>/<ClassName>/*.jpg. Needs pillow + numpy (both in requirements.txt).
# APPEARANCE ONLY: it can corroborate that water LOOKS contaminated, never that it is safe, and it
# never contributes to the risk score. See the README for its measured accuracy before relying on it.
# ECOSENTINEL_WATER_DATASET_MATCHING=true
# ECOSENTINEL_WATER_DATASET_IMAGES_PATH=../datasets
# ECOSENTINEL_WATER_DATASET_MATCH_THRESHOLD=0.62
# ECOSENTINEL_WATER_DATASET_TOP_K=5
# ECOSENTINEL_WATER_DATASET_FLAG_LEVELS=HIGH,MODERATE

# --- Citizen contamination reports ---
# Reports are always written to ECOSENTINEL_REPORTS_PATH. They are forwarded onwards ONLY when a
# webhook URL is set here; with no destination the API states plainly that nothing was transmitted
# and never implies an authority received anything.
# ECOSENTINEL_REPORTS_PATH=data/reports
# ECOSENTINEL_AUTHORITY_WEBHOOK_URL=https://example.org/pollution-intake
# ECOSENTINEL_AUTHORITY_WEBHOOK_TOKEN=
# ECOSENTINEL_AUTHORITY_NAME=State Pollution Control Board

# --- Nearby water bodies via the OpenStreetMap Overpass API ---
# GEOGRAPHIC CONTEXT ONLY: names, types and positions of water features. Overpass holds no
# water-quality data and never contributes to a risk score — it answers "which lake is this?",
# which is what makes a contamination report actionable.
# No API key. Overpass is donated infrastructure: the client throttles, caches and caps every
# query. Point the base URL at your own instance if you query it heavily.
# ECOSENTINEL_OVERPASS_ENABLED=true
# ECOSENTINEL_OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# ECOSENTINEL_OVERPASS_RADIUS_M=1500
# ECOSENTINEL_OVERPASS_MAX_RADIUS_M=5000
# ECOSENTINEL_OVERPASS_MAX_RESULTS=12
# ECOSENTINEL_OVERPASS_TIMEOUT_SECONDS=25
# ECOSENTINEL_OVERPASS_CACHE_DISTANCE_M=250

# --- Geographic context enrichment (POST /api/location/context, and the LangGraph
#     `context_enrichment` node) ---
# Uses the SAME Overpass settings above (base URL, radius, timeout, cache, enable flag), so there
# is one Overpass budget for the whole backend rather than two competing ones.
#
# CONTEXT ONLY, and this matters: Overpass reports what OpenStreetMap contributors have MAPPED —
# industrial land, waste facilities, waterways, major roads. A mapped factory is a polygon
# somebody drew. It is not an emission, not a measurement, and not evidence that anything is
# polluting. This data never reaches the Coordinator and never moves a risk score; it only tells
# a reader what is around the point they analysed.
#
# ECOSENTINEL_OVERPASS_RADIUS_M above is the search radius (default 1500 m, capped by
# ECOSENTINEL_OVERPASS_MAX_RADIUS_M). Keep it modest: a large radius makes an expensive query
# against donated infrastructure and returns features too far away to be informative.
# ECOSENTINEL_OVERPASS_MAX_RESULTS caps each category independently, so a dense mesh of mapped
# drains cannot crowd out the one mapped landfill.
# Hard ceiling on the geographic-enrichment node inside the LangGraph analysis. The Coordinator
# fan-in waits on that node, so an unbounded Overpass call stalls the whole assessment — keep this
# comfortably below the frontend's 30 s analysis timeout.
# ECOSENTINEL_OVERPASS_CONTEXT_TIMEOUT=10
