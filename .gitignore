.venv/
__pycache__/
backend/.env
.DS_Store

# Generated by the Water Agent's reference matcher / citizen reports
backend/data/water_dataset_index.npz
backend/data/reports/

# YOLO weights — 6 MB+ binaries, fetched on demand (see backend/.env.example)
backend/models/*.pt

# --- Datasets: excluded from version control -------------------------------------------------
# Two reasons, either of which is sufficient.
#
# SIZE. These total ~11 GB. GitHub rejects any file over 100 MB and a repo this size would be
# unusable to clone. Datasets belong with their publishers, not in application history.
#
# REDISTRIBUTION RIGHTS. Committing a dataset to a public repository is redistributing it.
# IWHR is Apache 2.0 and TUD-GV is CC BY 4.0, so both would need their attribution carried;
# FloW-Img's rights are UNRESOLVED (see docs/DATASET_PROVENANCE.md, blocker B3) and it must not
# be redistributed at all. Provenance, DOIs and licences are documented instead.
datasets/
water_datasets/
garbage_Dataset/
TACO-master/

# Dataset labels re-emitted under runs/ by the experiment harness. Same redistribution objection as
# above: runs/experiments/litter_localizer/dataset/labels/ is TACO's annotations with the class ids
# collapsed to one (see that experiment's EXPERIMENT_MANIFEST.json), so committing it redistributes
# the dataset. Regenerable from the harness; the manifest that pins the split is kept.
runs/experiments/**/dataset/labels/

# Trained weights and training artefacts. Reproducible from the documented scripts and the
# audited split manifests; the reports that justify them are kept (see below).
runs/**/*.pt
runs/**/*.npy
runs/**/*.npz
runs/water/tudgv_yolo/
runs/**/weights/

# Large local demo images kept out of history; the docs name which ones the demo uses.
image*.png
*.jpeg

# Training/evaluation IMAGE artefacts. The reports, metrics and manifests that these illustrate
# are kept (runs/**/*.md, *.json, *.csv) — those are the evidence. The renderings are up to
# 31 MB each and are regenerable from the scripts that produced them.
runs/**/*.png
runs/**/*.jpg
runs/**/*.jpeg
yolov8n.pt
backend/.env*

# Local safety-report database. Holds worker-submitted report text and GPS fixes — reporter
# content, not source. The schema lives in backend/safety/store.py and the file is recreated on
# first run, so nothing is lost by keeping it out of history.
backend/data/*.db

# Cached OpenStreetMap road graphs for worker routing. Refetched on demand; the Overpass query
# that produces them is in backend/safety/routing.py, so nothing is lost by keeping them out.
backend/data/route_graph_cache/

# Worker-uploaded photo evidence. Personal content captured by real people at real locations —
# it belongs on the deployment's persistent disk, never in source history.
backend/data/report_photos/

# Frontend local environment. `.env.example` IS committed; a developer's own .env is not.
frontend/.env
frontend/.env.*
!frontend/.env.example

# Ultralytics label caches. Regenerated automatically from the label files beside them; the
# labels and manifests ARE kept, because those are the evidence.
*.cache
