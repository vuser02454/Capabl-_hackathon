# Frontend build-time configuration.
#
# These are compiled into the bundle every visitor downloads. Put URLs here, never secrets:
# no Groq key, no Gemini key, no database credential, no private token. The backend holds those.

# Leave BLANK for local development — requests then use a relative path and Vite's dev proxy
# forwards them to the backend on :8000, so the browser stays on one origin and CORS never applies.
VITE_API_BASE_URL=

# In production (Vercel), set this to the deployed backend's origin, with no trailing slash:
# VITE_API_BASE_URL=https://your-service.onrender.com
